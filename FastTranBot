@bot.message_handler(func=lambda message: message.text and message.chat.id in pending_report)
def handle_report(message):
    chat_id = message.chat.id
    report_type = pending_report.pop(chat_id)
    now = jdatetime.datetime.now()
    date_str = now.strftime("%Y/%m/%d")
    time_str = now.strftime("%H:%M:%S")
    user_fullname = message.from_user.first_name + (" " + message.from_user.last_name if message.from_user.last_name else "")
    report_message = (
        f"📝 گزارش جدید:\n\n"
        f"👤 نام کاربر: {user_fullname}\n"
        f"🆔 شناسه: {message.from_user.id}\n"
        f"📅 تاریخ: {date_str}\n"
        f"⏰ ساعت: {time_str}\n"
        f"🔍 نوع گزارش: {'باگ' if report_type=='bug' else 'پیشنهاد'}\n"
        f"🗒 متن گزارش:\n{message.text}"
    )
    bot.send_message(ADMIN_CHAT_ID, report_message)
    markup = InlineKeyboardMarkup()
    markup.add(InlineKeyboardButton("🔙 بازگشت", callback_data="back_to_main"))
    bot.send_message(chat_id, "✅ پیام شما ارسال شد.", reply_markup=markup)

