def create_vote_markup(msg_id):
    markup = InlineKeyboardMarkup(row_width=2)
    markup.row(
        InlineKeyboardButton("👍🏻", callback_data=f"vote_up_{msg_id}"),
        InlineKeyboardButton("👎🏻", callback_data=f"vote_down_{msg_id}")
