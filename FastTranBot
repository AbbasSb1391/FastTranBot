    return markup

##########################################
# تابع ایجاد منوی انتخاب زبان تک‌زبانه (با صفحه‌بندی)
##########################################
def language_selection_panel(callback_prefix, back_callback, page=1):
    markup = InlineKeyboardMarkup(row_width=1)
    total = len(sorted_langs)
    start_index = (page - 1) * LANGS_PER_PAGE
    end_index = min(page * LANGS_PER_PAGE, total)
    for code, lang in sorted_langs[start_index:end_index]:
        markup.add(InlineKeyboardButton(lang, callback_data=f"{callback_prefix}_{code}"))
    nav_buttons = []
    if page > 1:
        nav_buttons.append(InlineKeyboardButton("◀️ قبلی", callback_data=f"{callback_prefix}_page_{page-1}"))
    if end_index < total:
        nav_buttons.append(InlineKeyboardButton("▶️ بعدی", callback_data=f"{callback_prefix}_page_{page+1}"))
    if nav_buttons:
        markup.add(*nav_buttons)
    markup.add(InlineKeyboardButton("🔙 بازگشت", callback_data=back_callback))
    return markup

