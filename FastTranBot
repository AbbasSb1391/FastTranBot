# دریافت متن و ترجمه (برای ترجمه تک‌زبانه و اضافه کردن رای‌دهی)
##########################################
@bot.message_handler(func=lambda message: message.text and message.chat.id not in pending_report)
def handle_text(message):
    chat_id = message.chat.id
    # اگر حالت ترجمه چندزبانه است:
    if current_mode.get(chat_id) == "multi":
        target_codes = multi_targets.get(chat_id, [])
        if not target_codes:
            bot.send_message(chat_id, "❗ هیچ زبان مقصدی انتخاب نشده است. لطفاً از منوی ترجمه چند زبانه، زبان‌ها را انتخاب کنید.")
            return
        results = []
        for code in target_codes:
            try:
                translated = GoogleTranslator(source="auto", target=code).translate(message.text)
                results.append(f"{LANGUAGES.get(code, code)}: {translated}")
            except Exception as e:
                results.append(f"{LANGUAGES.get(code, code)}: خطا در ترجمه")
        result_text = "🌐 ترجمه چند زبانه:\n" + "\n".join(results)
        translation_history.setdefault(chat_id, []).append((message.text, results[0] if results else ""))
        # ثبت انتخاب‌های چندزبانه قبل از پاکسازی
        selected_targets = multi_targets.get(chat_id, []).copy()
        sent_msg = bot.send_message(chat_id, result_text)
        vote_kb = create_vote_markup(sent_msg.message_id)
        bot.edit_message_reply_markup(chat_id, sent_msg.message_id, reply_markup=vote_kb)
        # در صورت چندزبانه، برای نمایش می‌توانیم "multi" را ذخیره کنیم و لیست زبان‌های مقصد را به صورت رشته‌ای ذخیره کنیم
        translation_votes[sent_msg.message_id] = (message.text, result_text, "multi", ", ".join(selected_targets))
        current_mode[chat_id] = None
        multi_targets[chat_id] = []
    else:
        source_lang = selected_languages.get(chat_id, {}).get("source", "auto")
        target_lang = selected_languages.get(chat_id, {}).get("target", "en")
        try:
            translated_text = GoogleTranslator(source=source_lang, target=target_lang).translate(message.text)
            translation_history.setdefault(chat_id, []).append((message.text, translated_text))
            msg_text = f"🔹 ترجمه:\n{translated_text}"
            sent_msg = bot.send_message(chat_id, msg_text)
            vote_kb = create_vote_markup(sent_msg.message_id)
            bot.edit_message_reply_markup(chat_id, sent_msg.message_id, reply_markup=vote_kb)
            translation_votes[sent_msg.message_id] = (message.text, translated_text, source_lang, target_lang)
        except Exception as e:
            bot.send_message(chat_id, f"⚠️ خطا در ترجمه: {e}",
                             reply_markup=InlineKeyboardMarkup().add(InlineKeyboardButton("🔙 بازگشت", callback_data="start_translation")))

