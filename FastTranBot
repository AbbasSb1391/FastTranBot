# تابع ایجاد منوی انتخاب زبان چندزبانه (با صفحه‌بندی، دو ستونی)
##########################################
def multi_language_selection_panel(chat_id, page=1):
    markup = InlineKeyboardMarkup(row_width=2)
    total = len(sorted_langs)
    start_index = (page - 1) * LANGS_PER_PAGE
    end_index = min(page * LANGS_PER_PAGE, total)
    for code, lang in sorted_langs[start_index:end_index]:
        button_text = f"✅ {lang}" if code in multi_targets.get(chat_id, []) else lang
        markup.add(InlineKeyboardButton(button_text, callback_data=f"multi_lang_{code}"))
    nav_buttons = []
    if page > 1:
        nav_buttons.append(InlineKeyboardButton("◀️ قبلی", callback_data=f"multi_lang_page_{page-1}"))
    if end_index < total:
        nav_buttons.append(InlineKeyboardButton("▶️ بعدی", callback_data=f"multi_lang_page_{page+1}"))
    if nav_buttons:
        markup.add(*nav_buttons)
    markup.add(InlineKeyboardButton("✅ تأیید", callback_data="multi_confirm"),
               InlineKeyboardButton("🔙 بازگشت", callback_data="start_translation"))
    return markup

